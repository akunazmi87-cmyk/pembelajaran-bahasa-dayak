
{
  "entities": {
    "TranslationHistory": {
      "title": "Translation History",
      "description": "Stores user translation history for Dayak Ngaju",
      "type": "object",
      "properties": {
        "indonesian": { "type": "string" },
        "ngaju": { "type": "string" },
        "source": { "type": "string", "enum": ["database", "ai"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["indonesian", "ngaju", "source", "timestamp"]
    },
    "GameProfile": {
      "title": "Game Profile",
      "description": "Stores user game stats for Word Scramble",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "totalPoints": { "type": "number" },
        "level": { "type": "string" },
        "highScore": { "type": "number" },
        "badges": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "totalPoints", "level", "highScore", "badges"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/translation_history/{historyId}": {
      "schema": "#/entities/TranslationHistory",
      "description": "User translation history"
    },
    "/game_profiles/{userId}": {
      "schema": "#/entities/GameProfile",
      "description": "User game statistics and achievements"
    }
  }
}
