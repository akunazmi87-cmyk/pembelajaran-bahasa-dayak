
{
  "entities": {
    "Vocabulary": {
      "title": "Vocabulary",
      "description": "Master list of Dayak Ngaju vocabulary",
      "type": "object",
      "properties": {
        "indonesian": { "type": "string" },
        "ngaju": { "type": "string" },
        "category": { "type": "string" },
        "audioUrl": { "type": "string" }
      },
      "required": ["indonesian", "ngaju", "category"]
    },
    "WebsiteStats": {
      "title": "Website Stats",
      "description": "Public statistics for the website",
      "type": "object",
      "properties": {
        "totalVisitors": { "type": "number" }
      },
      "required": ["totalVisitors"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Profile data for registered students",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "xp": { "type": "number" },
        "level": { "type": "number" }
      },
      "required": ["name", "username", "email", "role"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/vocabulary/{wordId}": {
      "schema": "#/backend/entities/Vocabulary",
      "description": "Master vocabulary collection"
    },
    "/stats/{statId}": {
      "schema": "#/backend/entities/WebsiteStats",
      "description": "Public statistics collection"
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile collection"
    }
  }
}
